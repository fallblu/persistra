{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fallblu.github.io/persistra/schemas/research-manifest-v1.schema.json",
  "title": "Persistra research manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "datasets", "parameters", "environment", "random_seeds", "execution"],
  "properties": {
    "manifest_version": {"const": 1},
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "labels", "splits", "benchmarks", "models"],
      "properties": {
        "features": {"$ref": "#/$defs/portableObject"},
        "labels": {"$ref": "#/$defs/portableObject"},
        "splits": {"$ref": "#/$defs/portableObject"},
        "benchmarks": {"$ref": "#/$defs/portableObject"},
        "models": {"$ref": "#/$defs/portableObject"}
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "random_seeds": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer"}
    },
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "portable": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/portable"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/portable"}}
      ]
    },
    "portableObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/portable"}
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "schema_version", "content_identity", "snapshot_identity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/portableObject"},
        "schema_version": {"type": "string", "minLength": 1},
        "content_identity": {"type": ["string", "null"], "minLength": 1},
        "snapshot_identity": {"type": ["string", "null"], "minLength": 1}
      },
      "anyOf": [
        {"properties": {"content_identity": {"type": "string"}}},
        {"properties": {"snapshot_identity": {"type": "string"}}}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifacts"],
      "properties": {
        "status": {"enum": ["not-run", "succeeded", "failed"]},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      },
      "if": {"properties": {"status": {"const": "not-run"}}},
      "then": {"properties": {"artifacts": {"maxItems": 0}}}
    }
  }
}
